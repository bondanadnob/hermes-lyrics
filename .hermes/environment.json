{
  "version": 1,
  "recipe": {
    "name": "Hermes Apple Music Lyrics plugin",
    "kind": "hermes-plugin",
    "bootstrap": [
      "python -m pip install -e '.[dev]'"
    ],
    "build": [
      "ruff check .",
      "node --check desktop/plugin.js",
      "node --check dashboard/dist/index.js"
    ],
    "test": [
      "python -m unittest discover -s tests -v"
    ],
    "start": "python scripts/verify_server.py --port 54782",
    "port": 54782,
    "readinessPath": "/health",
    "evidence": [
      "Loads the scoped FastAPI router and asserts its complete route contract",
      "Boots a loopback-only deterministic health server for readiness polling"
    ]
  }
}
